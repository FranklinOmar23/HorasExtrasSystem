# Copia este archivo a .env y ajusta los valores para tu entorno.
# Prisma 7 no permite `url` dentro de schema.prisma: la cadena de conexión
# vive acá y se referencia desde prisma.config.ts (usado por la CLI/Migrate)
# y desde PrismaService (runtime, vía el driver adapter @prisma/adapter-mssql).

# ── DATABASE_URL ─────────────────────────────────────────────────────────
# Elige UNA de las dos variantes de abajo según cómo corras SQL Server.

# Variante A (por defecto en desarrollo local, SIN Docker): SQL Server
# corriendo en tu propia máquina (o accesible por red), con un usuario SQL
# dedicado — no el usuario "sa". "horas" es el usuario creado para esta app;
# ajusta el nombre/clave a los tuyos.
DATABASE_URL="sqlserver://localhost:1433;database=horas_extras;user=horas;password=CAMBIAR_ESTA_CLAVE;encrypt=true;trustServerCertificate=true"

# Variante B: SQL Server corriendo en un contenedor Docker (ej. el servicio
# se llama "sqlserver" en tu docker-compose.yml). Descomenta esta línea y
# comenta la de arriba.
# DATABASE_URL="sqlserver://sqlserver:1433;database=horas_extras;user=sa;password=CAMBIAR_ESTA_CLAVE;trustServerCertificate=true"

# ── Servidor ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Autenticación ────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_DEV_SECRET
JWT_EXPIRES_IN=8h

# ── Seed (opcional): usuario ADMIN inicial creado por `npm run db:seed` ──
# Si se omiten, se usan los valores por defecto de prisma/seed.ts.
# SEED_ADMIN_EMAIL=admin@hartemania.com
# SEED_ADMIN_PASSWORD=CambiarInmediatamente123
