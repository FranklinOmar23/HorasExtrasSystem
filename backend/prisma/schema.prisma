// Prisma schema — Sistema de Horas Extras
// NOTA: modelo inicial inferido de las reglas resumidas en CLAUDE.md.
// Ajustar cuando exista docs/03-modelo-datos.md como fuente de verdad definitiva.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "sqlserver"
}

// SQL Server no soporta enums nativos en Prisma: se modelan como String
// y se validan/tipan con los enums de dominio (src/domain/enums) en la app.

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          String   @db.VarChar(10)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  periodosCerrados         Periodo[]         @relation("PeriodoCerradoPor")
  periodosEliminados       Periodo[]         @relation("PeriodoEliminadoPor")
  importaciones            Importacion[]
  auditorias               Auditoria[]
  asignacionesTurnoCreadas AsignacionTurno[]

  @@map("usuarios")
}

model Empleado {
  id        String   @id @default(uuid())
  codigo    Int      @unique
  nombre    String
  /// `@unique` aquí genera una UNIQUE CONSTRAINT normal en el `db push`/diff
  /// inicial, pero en producción se reemplazó por un índice único FILTRADO
  /// (`WHERE cedula IS NOT NULL`, ver migración `cedula_indice_filtrado_nulos`)
  /// porque SQL Server exige unicidad también entre NULLs bajo una
  /// constraint normal, y muchos empleados reales no tienen cédula registrada.
  /// Si se regenera una migración desde este schema, hay que volver a aplicar
  /// ese ajuste manualmente.
  cedula    String?  @unique
  posicion  String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salarios          Salario[]
  registrosHoras    RegistroHoras[]
  asignacionesTurno AsignacionTurno[]

  @@map("empleados")
}

/// Vista SQL (`vw_empleados`, ver prisma/migrations) que pre-une `empleados`
/// con su `Salario` VIGENTE (`vigenteHasta IS NULL`). Antes de esta vista, la
/// pantalla de Empleados hacía una petición GET /empleados/:id/salarios POR
/// CADA fila para mostrar el salario mensual — un N+1 real a nivel de HTTP.
/// `montoMensualVigente`/`salarioVigenteDesde` son NULL si el empleado no
/// tiene ningún salario vigente (no debería pasar en la práctica, pero la
/// vista no lo garantiza con un INNER JOIN). Es de solo lectura — Prisma no
/// puede escribir en una vista. `id` se declara `@unique` (no `@id`, Prisma
/// lo prohíbe en vistas), sigue siendo único porque el join es 1 a 1 o 1 a 0.
view VwEmpleado {
  id                  String   @unique
  codigo              Int
  nombre              String
  cedula              String?
  posicion            String
  activo              Boolean
  montoMensualVigente Decimal? @db.Decimal(12, 2)
  salarioVigenteDesde DateTime?

  @@map("vw_empleados")
}

/// Historial de salarios con vigencia: el cálculo usa el salario vigente
/// en la fecha del registro, no el salario actual del empleado.
model Salario {
  id           String    @id @default(uuid())
  empleadoId   String
  montoMensual Decimal   @db.Decimal(12, 2)
  vigenteDesde DateTime  @db.Date
  vigenteHasta DateTime? @db.Date
  createdAt    DateTime  @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Prisma no puede expresar un índice único FILTRADO en el schema: en
  /// producción existe además `salarios_empleadoId_vigente_key`, un índice
  /// único en `empleadoId` con `WHERE vigenteHasta IS NULL` (ver migración
  /// `salario_unico_vigente_por_empleado`). Evita que dos POST
  /// `/empleados/:id/salarios` casi simultáneos dejen a un empleado con dos
  /// salarios "vigentes" a la vez (se detectó en producción). Si se
  /// regenera una migración desde este schema, hay que volver a aplicarlo.
  @@index([empleadoId, vigenteDesde])
  @@map("salarios")
}

/// Catálogo de tipos de hora extra y su porcentaje de recargo vigente.
/// El motor de cálculo copia el porcentaje en `calculos` para que un cambio
/// aquí no altere cálculos ya hechos.
///
/// `modoValorizacion` determina cómo se traduce el porcentaje a un monto:
/// - COMPLETA: la hora se paga completa más el recargo (multiplicador = 1 + porcentaje/100).
///   Usado por HE_35 (×1.35) y HE_100 (×2.00): son horas que el salario
///   mensual no cubre en absoluto.
/// - SOLO_RECARGO: solo se paga el recargo (multiplicador = porcentaje/100).
///   Usado por NOCTURNA_15 (×0.15, un adicional sobre horas ya pagadas por
///   otro tipo) y FERIADO (×1.00, la hora adicional completa pero sin volver
///   a duplicarla como si fuera 200%).
model TipoHoraExtra {
  id               String  @id @default(uuid())
  codigo           String  @unique @db.VarChar(20)
  nombre           String
  porcentaje       Decimal @db.Decimal(6, 2)
  modoValorizacion String  @default("COMPLETA") @db.VarChar(20)
  activo           Boolean @default(true)

  calculos Calculo[]

  @@map("tipos_hora_extra")
}

/// Parámetros de cálculo como clave-valor (divisor de salario, horarios,
/// tolerancia, redondeo...). Nunca hardcodear estos valores en el dominio.
model Configuracion {
  clave     String   @id @db.VarChar(50)
  valor     String
  updatedAt DateTime @updatedAt

  @@map("configuracion")
}

model Feriado {
  id          String   @id @default(uuid())
  fecha       DateTime @unique @db.Date
  descripcion String
  createdAt   DateTime @default(now())

  @@map("feriados")
}

/// Un periodo CERRADO es inmutable: cualquier escritura sobre sus registros
/// o cálculos (etapas 4-5) debe lanzar PeriodoCerradoError.
///
/// La eliminación es un soft-delete (`eliminadoEn`/`eliminadoPorId`): nunca se
/// borra la fila ni sus registros/cálculos/importaciones asociados (es
/// historial de dinero), solo se oculta de los listados. Es restaurable
/// dentro de un plazo de 30 días desde `eliminadoEn` (ver RestaurarPeriodoUseCase).
model Periodo {
  id             String    @id @default(uuid())
  fechaInicio    DateTime  @db.Date
  fechaFin       DateTime  @db.Date
  estado         String    @default("ABIERTO") @db.VarChar(10)
  cerradoEn      DateTime?
  cerradoPorId   String?
  eliminadoEn    DateTime?
  eliminadoPorId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cerradoPor     Usuario?        @relation("PeriodoCerradoPor", fields: [cerradoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eliminadoPor   Usuario?        @relation("PeriodoEliminadoPor", fields: [eliminadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registrosHoras RegistroHoras[]
  importaciones  Importacion[]

  @@unique([fechaInicio, fechaFin])
  @@map("periodos")
}

/// Marcación de entrada/salida de un empleado en un día de un periodo.
/// horaEntrada/horaSalida se guardan como "HH:mm" (mismo formato que los
/// horarios en `configuracion`) para evitar el manejo de zonas horarias del
/// tipo TIME nativo de SQL Server.
model RegistroHoras {
  id            String   @id @default(uuid())
  periodoId     String
  empleadoId    String
  fecha         DateTime @db.Date
  horaEntrada   String   @db.VarChar(5)
  horaSalida    String   @db.VarChar(5)
  origen        String   @db.VarChar(10)
  importacionId String?
  comentario    String?
  /// true cuando `fecha` cae fuera de [periodo.fechaInicio, periodo.fechaFin]:
  /// horas de quincenas anteriores que RRHH decide pagar en el periodo actual.
  /// El cálculo (turno, feriado, salario vigente) siempre usa `fecha`, nunca
  /// las fechas del periodo — ver docs/02 §6. El monto sí se paga/reporta en
  /// este periodo (periodoId manda para efectos de pago).
  esRetroactivo Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  periodo     Periodo      @relation(fields: [periodoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  empleado    Empleado     @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  importacion Importacion? @relation(fields: [importacionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calculos    Calculo[]

  @@index([periodoId, empleadoId])
  @@map("registros_horas")
}

/// Desglose de horas extra de un registro, con el porcentaje y salario/hora
/// congelados al momento del cálculo (cambios posteriores en tipos_hora_extra
/// o en el salario del empleado no alteran calculos ya generados).
model Calculo {
  id                 String   @id @default(uuid())
  registroId         String
  tipoHoraId         String
  cantidadHoras      Decimal  @db.Decimal(8, 4)
  porcentajeAplicado Decimal  @db.Decimal(6, 2)
  salarioHoraUsado   Decimal  @db.Decimal(12, 4)
  monto              Decimal  @db.Decimal(12, 2)
  calculadoEn        DateTime @default(now())

  registro RegistroHoras @relation(fields: [registroId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tipoHora TipoHoraExtra @relation(fields: [tipoHoraId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([registroId])
  @@map("calculos")
}

/// Carga de un archivo .xlsx con marcaciones de un periodo, en dos pasos:
/// esta fila se crea al parsear/validar (sin tocar registros_horas todavía)
/// y `confirmadaEn` se llena cuando se confirma y se generan los
/// `registros_horas` (origen EXCEL). `contenido` guarda el archivo original
/// para poder re-parsear y re-validar exactamente igual al confirmar, en vez
/// de confiar en una vista previa que pudo quedar desactualizada.
model Importacion {
  id               String    @id @default(uuid())
  periodoId        String
  usuarioId        String
  archivo          String
  contenido        Bytes
  filasOk          Int
  filasAdvertencia Int
  filasError       Int
  filasRetroactivas Int      @default(0)
  importadoEn      DateTime  @default(now())
  confirmadaEn     DateTime?

  periodo        Periodo         @relation(fields: [periodoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registrosHoras RegistroHoras[]

  @@index([periodoId])
  @@map("importaciones")
}

/// Bitácora de auditoría: quién hizo qué cambio y cuándo, en todo el sistema
/// (periodos, empleados, salarios, configuración, feriados, tipos de hora
/// extra, registros de horas, importaciones y usuarios). Solo de lectura para
/// la UI — nunca se edita ni se borra una fila de auditoría.
model Auditoria {
  id          String   @id @default(uuid())
  usuarioId   String
  accion      String   @db.VarChar(20)
  entidad     String   @db.VarChar(30)
  entidadId   String?
  descripcion String
  creadoEn    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entidad, entidadId])
  @@index([creadoEn])
  @@map("auditorias")
}

/// Vista SQL (`vw_auditoria`, ver prisma/migrations) que pre-une `auditorias`
/// con `usuarios.nombre`: la pantalla de Auditoría siempre necesita el nombre
/// del usuario, así que se resuelve una sola vez en la base en vez de en cada
/// consulta de la aplicación. Es de solo lectura — Prisma no puede escribir
/// en una vista. `id` se declara `@unique` porque Prisma exige una clave para
/// cualquier vista, aunque SQL Server no admite PK sobre vistas: sigue siendo
/// único porque la vista es un join 1 a 1 (cada fila de auditorías tiene
/// exactamente un usuario).
view VwAuditoria {
  id            String   @unique
  usuarioId     String
  usuarioNombre String
  accion        String   @db.VarChar(20)
  entidad       String   @db.VarChar(30)
  entidadId     String?
  descripcion   String
  creadoEn      DateTime

  @@map("vw_auditoria")
}

/// Catálogo de turnos de trabajo. horaInicio/horaFin en formato "HH:mm"
/// (mismo criterio que horaEntrada/horaSalida en registros_horas, para no
/// lidiar con zonas horarias del tipo TIME nativo de SQL Server).
/// El horario del NOCTURNO es provisional hasta que RRHH confirme el
/// definitivo: por eso es 100% editable desde la pantalla de Configuración,
/// igual que el resto del catálogo.
model Turno {
  id                String  @id @default(uuid())
  codigo            String  @unique @db.VarChar(20)
  nombre            String
  horaInicio        String  @db.VarChar(5)
  horaFin           String  @db.VarChar(5)
  horasJornada      Decimal @db.Decimal(4, 2)
  cruzaMedianoche   Boolean @default(false)
  descuentaAlmuerzo Boolean @default(true)
  activo            Boolean @default(true)

  asignaciones AsignacionTurno[]

  @@map("turnos")
}

/// Asigna un turno a un empleado durante un rango de fechas (fechaHasta nulo
/// = indefinida). El turno vigente de un empleado en una fecha es la
/// asignación cuyo rango la cubre; si no hay ninguna, aplica DIURNO (o
/// SABADO si la fecha cae en sábado) por defecto — ver
/// ResolverTurnoDelEmpleadoUseCase. Los rangos de un mismo empleado nunca
/// deben solaparse: se valida en el use case (AsignacionSolapadaError), no
/// hay constraint de BD para esto porque SQL Server no expresa unicidad
/// sobre rangos de fecha de forma nativa.
model AsignacionTurno {
  id          String    @id @default(uuid())
  empleadoId  String
  turnoId     String
  fechaDesde  DateTime  @db.Date
  fechaHasta  DateTime? @db.Date
  comentario  String?
  createdAt   DateTime  @default(now())
  creadoPorId String

  empleado  Empleado @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  turno     Turno    @relation(fields: [turnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creadoPor Usuario  @relation(fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([empleadoId, fechaDesde, fechaHasta])
  @@map("asignaciones_turno")
}
