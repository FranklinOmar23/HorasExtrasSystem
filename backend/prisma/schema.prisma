// Prisma schema — Sistema de Horas Extras
// NOTA: modelo inicial inferido de las reglas resumidas en CLAUDE.md.
// Ajustar cuando exista docs/03-modelo-datos.md como fuente de verdad definitiva.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// SQL Server no soporta enums nativos en Prisma: se modelan como String
// y se validan/tipan con los enums de dominio (src/domain/enums) en la app.

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          String   @db.VarChar(10)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  periodosCerrados Periodo[]     @relation("PeriodoCerradoPor")
  importaciones    Importacion[]

  @@map("usuarios")
}

model Empleado {
  id        String   @id @default(uuid())
  codigo    Int      @unique
  nombre    String
  cedula    String?  @unique
  posicion  String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salarios       Salario[]
  registrosHoras RegistroHoras[]

  @@map("empleados")
}

/// Historial de salarios con vigencia: el cálculo usa el salario vigente
/// en la fecha del registro, no el salario actual del empleado.
model Salario {
  id           String    @id @default(uuid())
  empleadoId   String
  montoMensual Decimal   @db.Decimal(12, 2)
  vigenteDesde DateTime  @db.Date
  vigenteHasta DateTime? @db.Date
  createdAt    DateTime  @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([empleadoId, vigenteDesde])
  @@map("salarios")
}

/// Catálogo de tipos de hora extra y su porcentaje de recargo vigente.
/// El motor de cálculo copia el porcentaje en `calculos` para que un cambio
/// aquí no altere cálculos ya hechos.
///
/// `modoValorizacion` determina cómo se traduce el porcentaje a un monto:
/// - COMPLETA: la hora se paga completa más el recargo (multiplicador = 1 + porcentaje/100).
///   Usado por HE_35 (×1.35) y HE_100 (×2.00): son horas que el salario
///   mensual no cubre en absoluto.
/// - SOLO_RECARGO: solo se paga el recargo (multiplicador = porcentaje/100).
///   Usado por NOCTURNA_15 (×0.15, un adicional sobre horas ya pagadas por
///   otro tipo) y FERIADO (×1.00, la hora adicional completa pero sin volver
///   a duplicarla como si fuera 200%).
model TipoHoraExtra {
  id               String  @id @default(uuid())
  codigo           String  @unique @db.VarChar(20)
  nombre           String
  porcentaje       Decimal @db.Decimal(6, 2)
  modoValorizacion String  @default("COMPLETA") @db.VarChar(20)
  activo           Boolean @default(true)

  calculos Calculo[]

  @@map("tipos_hora_extra")
}

/// Parámetros de cálculo como clave-valor (divisor de salario, horarios,
/// tolerancia, redondeo...). Nunca hardcodear estos valores en el dominio.
model Configuracion {
  clave     String   @id @db.VarChar(50)
  valor     String
  updatedAt DateTime @updatedAt

  @@map("configuracion")
}

model Feriado {
  id          String   @id @default(uuid())
  fecha       DateTime @unique @db.Date
  descripcion String
  createdAt   DateTime @default(now())

  @@map("feriados")
}

/// Un periodo CERRADO es inmutable: cualquier escritura sobre sus registros
/// o cálculos (etapas 4-5) debe lanzar PeriodoCerradoError.
model Periodo {
  id           String    @id @default(uuid())
  fechaInicio  DateTime  @db.Date
  fechaFin     DateTime  @db.Date
  estado       String    @default("ABIERTO") @db.VarChar(10)
  cerradoEn    DateTime?
  cerradoPorId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cerradoPor     Usuario?        @relation("PeriodoCerradoPor", fields: [cerradoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registrosHoras RegistroHoras[]
  importaciones  Importacion[]

  @@unique([fechaInicio, fechaFin])
  @@map("periodos")
}

/// Marcación de entrada/salida de un empleado en un día de un periodo.
/// horaEntrada/horaSalida se guardan como "HH:mm" (mismo formato que los
/// horarios en `configuracion`) para evitar el manejo de zonas horarias del
/// tipo TIME nativo de SQL Server.
model RegistroHoras {
  id            String   @id @default(uuid())
  periodoId     String
  empleadoId    String
  fecha         DateTime @db.Date
  horaEntrada   String   @db.VarChar(5)
  horaSalida    String   @db.VarChar(5)
  origen        String   @db.VarChar(10)
  importacionId String?
  comentario    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  periodo     Periodo      @relation(fields: [periodoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  empleado    Empleado     @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  importacion Importacion? @relation(fields: [importacionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calculos    Calculo[]

  @@index([periodoId, empleadoId])
  @@map("registros_horas")
}

/// Desglose de horas extra de un registro, con el porcentaje y salario/hora
/// congelados al momento del cálculo (cambios posteriores en tipos_hora_extra
/// o en el salario del empleado no alteran calculos ya generados).
model Calculo {
  id                 String   @id @default(uuid())
  registroId         String
  tipoHoraId         String
  cantidadHoras      Decimal  @db.Decimal(8, 4)
  porcentajeAplicado Decimal  @db.Decimal(6, 2)
  salarioHoraUsado   Decimal  @db.Decimal(12, 4)
  monto              Decimal  @db.Decimal(12, 2)
  calculadoEn        DateTime @default(now())

  registro RegistroHoras @relation(fields: [registroId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tipoHora TipoHoraExtra @relation(fields: [tipoHoraId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([registroId])
  @@map("calculos")
}

/// Carga de un archivo .xlsx con marcaciones de un periodo, en dos pasos:
/// esta fila se crea al parsear/validar (sin tocar registros_horas todavía)
/// y `confirmadaEn` se llena cuando se confirma y se generan los
/// `registros_horas` (origen EXCEL). `contenido` guarda el archivo original
/// para poder re-parsear y re-validar exactamente igual al confirmar, en vez
/// de confiar en una vista previa que pudo quedar desactualizada.
model Importacion {
  id               String    @id @default(uuid())
  periodoId        String
  usuarioId        String
  archivo          String
  contenido        Bytes
  filasOk          Int
  filasAdvertencia Int
  filasError       Int
  importadoEn      DateTime  @default(now())
  confirmadaEn     DateTime?

  periodo        Periodo         @relation(fields: [periodoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registrosHoras RegistroHoras[]

  @@index([periodoId])
  @@map("importaciones")
}
